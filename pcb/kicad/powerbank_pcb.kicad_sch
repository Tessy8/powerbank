	(text "MCU SECTION"
		(exclude_from_sim no)
		(at 45.466 270.256 0)
		(effects
			(font
				(size 5.08 5.08)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "068e6d3c-ad44-4e79-9100-31c124ed076e")
	)
	(text "BQ25672 notes:\nILIM_HIZ to REGN: no input current limit, charge at max (3A)\nPROG resistor sets 1S default before I2C \nTS: fakes temp OK, no thermistor used.\n\nPROG to 3.0k sets 1S / 1.5MHz. \n1S POR default ICHG is only 1A; firmware must raise ICHG \nto 3A over I2C after startup for full-rate charge"
		(exclude_from_sim no)
		(at 98.806 123.698 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1a66ef84-7247-4fe8-b4ab-a355aefdd485")
	)
	(text "POWER SECTION"
		(exclude_from_sim no)
		(at 319.278 157.48 0)
		(effects
			(font
				(size 5.08 5.08)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "1aa9e09d-c165-4906-af71-416c50b80843")
	)
	(text "CE: charging enabled by default, MCU can pull high to disable\nINT: open-drain fault/status interrupt to MCU\n\n"
		(exclude_from_sim no)
		(at 19.05 278.892 0)
		(effects
			(font
				(size 1.27 1.27)
