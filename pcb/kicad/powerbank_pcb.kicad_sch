	)
	(text "USB-PD sink. Negotiates 9V from PD source (VSET = 6.07k). \nVBUS only reaches charger after successful PD negotiation. \nFalls back to 5V if source isn't PD \nISET - unconnected (3.25A max); I2C addr 0x08.\n\n* Order _002DD variant. Note that GATE turns PMOS on after POR, \nNOT after PD contract, so firmware must hold BQ25672 CE \ndisabled until I2C confirms 9V VBUS."
		(exclude_from_sim no)
		(at 21.844 154.686 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e6d0f250-4f04-4750-847f-84c5f11cefdb")
	)
